# ─────────────────────────────────────────────
# Meta / WhatsApp Business API
# ─────────────────────────────────────────────
# From Meta Developer Portal → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Choose any random string — used to verify the webhook URL with Meta
WEBHOOK_VERIFY_TOKEN=choose_any_random_string_here

# ─────────────────────────────────────────────
# Claude API (Anthropic)
# ─────────────────────────────────────────────
# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_api_key_here

# ─────────────────────────────────────────────
# Google Sheets
# ─────────────────────────────────────────────
# The long ID in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEETS_ID=your_google_sheet_id

# From your Google Cloud service account (IAM & Admin → Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=bot@your-project.iam.gserviceaccount.com

# Paste the full private key from your service account JSON file
# Keep the quotes and \n characters exactly as they appear
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# ─────────────────────────────────────────────
# Business Config
# ─────────────────────────────────────────────
# TODO: Update these for each client
BUSINESS_NAME=Bella's Salon
BUSINESS_PHONE=+91XXXXXXXXXX

# WhatsApp number to notify when a human handoff is triggered
HUMAN_HANDOFF_NUMBER=+91XXXXXXXXXX

# Server port (Railway sets this automatically)
PORT=3000
